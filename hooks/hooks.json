{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__(plugin_.+_)?robinhood-trading__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/tools/order_guard.py"],
            "onFailure": "block",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
